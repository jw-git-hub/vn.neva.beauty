<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>document.documentElement.classList.add('js')</script>
  {# Сорвавшийся запрос картинки (обрыв связи, таймаут узкого канала — так не
     догрузился hero во встроенном браузере Instagram) браузер сам не повторяет:
     <img> остаётся сломанным до перезагрузки страницы. Ловим ошибку в фазе
     capture — скрипт стоит до разметки, поэтому видит и ошибки при разборе HTML.
     Инлайном: внешний файл сам зависит от той же сети и приедет слишком поздно. #}
  <script>
  (function () {
    var DELAYS = [800, 2500, 6000];  // паузы перед повторными попытками, мс

    function rememberSource(img) {
      // Слушатель вешаем на саму картинку: её событие load, в отличие от error,
      // до window в фазе capture не доходит — общий обработчик его не увидит.
      img.dataset.imgSrc = img.src;
      img.addEventListener('load', function () { delete img.dataset.imgError; }, { once: true });
    }

    function reloadLater(img) {
      var attempt = Number(img.dataset.imgRetry || 0);
      if (attempt >= DELAYS.length) return;
      if (!img.dataset.imgSrc) rememberSource(img);
      img.dataset.imgRetry = attempt + 1;
      var src = img.dataset.imgSrc;
      setTimeout(function () {
        // Параметр обязателен: без него браузер отдаёт запомненную ошибку, не запрос.
        img.src = src + (src.indexOf('?') < 0 ? '?' : '&') + 'retry=' + (attempt + 1);
      }, DELAYS[attempt]);
    }

    addEventListener('error', function (event) {
      var img = event.target;
      if (!img || img.tagName !== 'IMG') return;
      img.dataset.imgError = '';
      reloadLater(img);
    }, true);
  })();
  </script>
  <title>{{ page.seo_title }}</title>
  <meta name="description" content="{{ page.seo_desc }}">
  <meta name="robots" content="{{ 'noindex, follow' if page.noindex else 'index, follow' }}">
  <link rel="canonical" href="{{ site.base_url }}{{ page.url }}">
  <link rel="alternate" hreflang="ru" href="{{ site.base_url }}{{ page.url }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.base_url }}{{ page.url }}">
  <meta property="og:type" content="{{ page.og_type | default('website') }}">
  <meta property="og:site_name" content="{{ site.brand }}">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:title" content="{{ page.seo_title }}">
  <meta property="og:description" content="{{ page.seo_desc }}">
  <meta property="og:url" content="{{ site.base_url }}{{ page.url }}">
  {# Превью ссылки — фирменная карточка 1200×630: это единственная пропорция, которую
     мессенджеры и соцсети показывают целиком, портретное фото они обрезают. Любая
     page.og_image должна быть того же размера, иначе width/height ниже соврут. Размеры
     нужны, чтобы клиент нарисовал превью сразу, не дожидаясь загрузки картинки. #}
  {% set og_image = site.base_url ~ (page.og_image | default('/assets/img/og-default.jpg')) %}
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.brand }} — {{ site.brand_location }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page.seo_title }}">
  <meta name="twitter:description" content="{{ page.seo_desc }}">
  <meta name="twitter:image" content="{{ og_image }}">
  {% if page.schema_json %}<script type="application/ld+json">{{ page.schema_json }}</script>{% endif %}
  {# Иконки: .ico для Яндекса и старых клиентов (его же браузер просит по умолчанию),
     .svg для современных браузеров, apple-touch-icon для «на главный экран» в iOS. #}
  <link rel="icon" href="{{ base_path }}/favicon.ico" sizes="32x32">
  <link rel="icon" href="{{ base_path }}/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ base_path }}/apple-touch-icon.png">
  <link rel="manifest" href="{{ base_path }}/site.webmanifest">
  <meta name="theme-color" content="{{ theme_color }}">
  {% if page.hero_image %}<link rel="preload" as="image" href="{{ base_path }}{{ page.hero_image }}" fetchpriority="high">{% endif %}
  {# Все четыре файла нужны на первом экране любой страницы, поэтому качаем их сразу,
     не дожидаясь разбора CSS. Латиница здесь не роскошь: ею набран логотип в шапке
     и слово «Neva Beauty» внутри заголовка — раньше она приезжала последней. #}
  {% for font in ('cormorant-cyrillic', 'manrope-cyrillic', 'cormorant-latin', 'manrope-latin') %}
  <link rel="preload" as="font" type="font/woff2" href="{{ base_path }}/assets/fonts/{{ font }}.woff2" crossorigin>
  {%- endfor %}
  <link rel="stylesheet" href="{{ base_path }}/assets/css/bundle.min.css">
  {% block extra_css %}{% endblock %}
</head>
<body>
  {% include 'partials/aurora.html.j2' %}
  {% include 'partials/header.html.j2' %}
  {# drawer/overlay — на уровне body, вне backdrop-filter хедера,
     иначе их position:fixed считается от коробки хедера, а не вьюпорта #}
  {% include 'partials/drawer.html.j2' %}
  <main id="main">{% block content %}{% endblock %}</main>
  {% include 'partials/footer.html.j2' %}
  <script type="module" src="{{ base_path }}/assets/js/nav.js"></script>
  <script type="module" src="{{ base_path }}/assets/js/reveal.js"></script>
  <script type="module" src="{{ base_path }}/assets/js/aurora.js"></script>
  {% block extra_js %}{% endblock %}
  {% include 'partials/metrika.html.j2' %}
</body>
</html>
