{% extends "base.html.j2" %}
{% from "partials/picture.html.j2" import responsive_img %}
{% block content %}
<section class="svc-hero">
  <div class="container">
    <nav class="breadcrumbs breadcrumbs--lead" aria-label="{{ t('nav.breadcrumbs_label') }}">
      <a href="{{ href('home') }}">{{ t('nav.home') }}</a>
      {% if category.is_page %}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <a href="{{ category.href }}">{{ category.title }}</a>
      {% endif %}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ svc.title }}</span>
    </nav>
    <div class="svc-hero__inner">
      <div class="svc-hero__text">
        <p class="eyebrow">{{ svc.category }}</p>
        <h1>{{ svc.title }}</h1>
        <p class="svc-hero__intro">{{ svc.intro }}</p>
        <a class="btn btn--primary" href="{{ site.contacts.whatsapp_url }}?text={{ t('contact.text_page', title=svc.title) | urlencode }}" target="_blank" rel="noopener">{{ t('cta.book') }}</a>
      </div>
      <div class="svc-hero__media">
        <span class="svc-hero__blob" aria-hidden="true"></span>
        {{ responsive_img(svc.hero_image, 'service_hero', t('service.hero_alt', title=svc.title), priority=True) }}
      </div>
    </div>
  </div>
</section>

{% if svc.benefits %}
<section class="section container">
  {#- Заголовок блока переопределяется из content.yml: где задан benefits_title,
     стоит вопрос, как его задаёт аудитория, и ответ идёт первым предложением
     под каждым пунктом. Где не задан — прежний заголовок. #}
  <div class="section-head" data-reveal><p class="eyebrow">{{ svc.benefits_eyebrow or t('service.benefits_eyebrow') }}</p><h2>{{ svc.benefits_title or t('service.benefits_title') }}</h2></div>
  <div class="svc-benefits" data-reveal-children>
    {% for b in svc.benefits %}
    <div class="svc-benefit"><span class="svc-benefit__icon">{{ icon(b.icon) }}</span><h3>{{ b.title }}</h3><p>{{ b.text }}</p></div>
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="section pricelist-section">
  <div class="container">
    {#- price_lead приходит из content.yml с уже подставленной ценой из прайса
       (pages.fill_tokens): под заголовком-вопросом первым идёт прямой ответ. #}
    <div class="section-head" data-reveal><p class="eyebrow">{{ t('service.price_eyebrow') }}</p><h2>{{ svc.price_title or t('service.price_title') }}</h2><p>{{ svc.price_lead or t('service.price_lead') }}</p></div>
    <div class="pricelist" data-pricelist>
      {% set tabbed = sections|length > 1 %}
      {% if tabbed %}
      {# Вкладки и панели связаны по id: aria-controls/aria-labelledby — по ним же
         price-tabs.js находит панель, второго источника связи не нужно. #}
      <div class="pricelist__tabs" role="tablist" aria-label="{{ t('service.price_tabs_label') }}">
        {% for sec in sections %}
        <button class="pricelist__tab{{ ' is-active' if loop.first }}" type="button" role="tab"
          id="price-tab-{{ loop.index0 }}" aria-controls="price-panel-{{ loop.index0 }}"
          aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ sec.section or t('service.price_section_default') }}</button>
        {% endfor %}
      </div>
      {% endif %}
      {% for sec in sections %}
      <div class="pricelist__panel{{ ' is-active' if loop.first }}"{% if tabbed %} id="price-panel-{{ loop.index0 }}" role="tabpanel" aria-labelledby="price-tab-{{ loop.index0 }}" tabindex="0"{% endif %}>
        {% set combos = sec['items'] | selectattr('is_combo') | list %}
        {% set rows = sec['items'] | rejectattr('is_combo') | list %}
        {% if combos %}
        <ul class="pricelist__combos">
          {% for c in combos %}
          <li class="combo">
            <div class="combo__name">{{ c.name }}</div>
            {% if c.desc %}<div class="combo__desc">{{ c.desc }}</div>{% endif %}
            <div class="combo__price">{{ c.price }}</div>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if rows %}
        <div class="pricelist__rows">
          {# Настоящая таблица: связь «услуга → цена» видна поисковикам, ИИ-ассистентам
             и скринридерам. Заголовки колонок скрыты визуально, но есть в разметке. #}
          <table class="pricelist__table">
            <caption class="visually-hidden">{{ svc.title }} — {{ sec.section or t('service.price_section_default') }}</caption>
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">{{ t('service.col_service') }}</span></th>
                <th scope="col"><span class="visually-hidden">{{ t('service.col_price') }}</span></th>
              </tr>
            </thead>
            <tbody>
              {% for it in rows %}
              <tr class="pricelist__row">
                <th class="pricelist__name" scope="row">{{ it.name }}{% if it.desc %}<span class="pricelist__desc">{{ it.desc }}</span>{% endif %}</th>
                <td class="pricelist__price">{{ it.price }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{%- if svc.compare %}
{#- Сравнение с соседними услугами: настоящая <table>, строки и цены собраны
   в pricing.compare_rows из content.yml и prices.json. Классы прайс-листа
   переиспользуются намеренно — таблица выглядит как остальные на сайте
   и не требует своего CSS. Панели прайса (.pricelist__panel) здесь нет:
   она скрыта до активации и в неё же смотрит парити-тест цен. #}
<section class="section container">
  <div class="section-head" data-reveal><p class="eyebrow">{{ svc.compare.eyebrow }}</p><h2>{{ svc.compare.title }}</h2><p>{{ svc.compare.lead }}</p></div>
  <div class="pricelist" data-reveal>
    <div class="pricelist__rows">
      <table class="pricelist__table compare__table">
        <caption class="visually-hidden">{{ svc.compare.caption }}</caption>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{{ t('service.col_compare') }}</span></th>
            <th scope="col"><span class="visually-hidden">{{ t('service.col_price') }}</span></th>
          </tr>
        </thead>
        {#- Названия без ссылок: единственный стиль ссылки в тексте — .faq__a a,
           внутри таблицы ссылка была бы неотличима от обычного текста. На эти же
           услуги ведут ссылки из ответа FAQ под таблицей. #}
        <tbody>
          {% for row in svc.compare.rows %}
          <tr class="pricelist__row">
            <th class="pricelist__name" scope="row">{{ row.title }}<span class="pricelist__desc">{{ row.task }}</span></th>
            <td class="pricelist__price">{{ row.price }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{%- endif %}

{% if svc.faq %}
<section class="section container" id="faq">
  <div class="section-head" data-reveal><p class="eyebrow">{{ t('faq.eyebrow') }}</p><h2>{{ t('faq.title', title=svc.title) }}</h2></div>
  <div class="faq" data-reveal-children>
    {% for item in svc.faq %}
    <details class="faq__item"{% if loop.first %} open{% endif %}>
      <summary class="faq__q">{{ item.q }}</summary>
      <p class="faq__a">{{ item.a | safe }}</p>
    </details>
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container booking">
    {#- Заголовок приходит от страницы. Один и тот же h2 на 14 страницах не
       говорил ни клиенту, ни роботу, о чём именно блок, и место в структуре
       страницы тратилось впустую. Дубли ловит check_headings.py.
       Подводка намеренно осталась общей: заказчик разрешил править только
       заголовки, остальной текст vn — отдельным решением. #}
    <div class="section-head" data-reveal><p class="eyebrow">{{ t('booking.eyebrow') }}</p><h2>{{ svc.booking_title }}</h2><p>{{ t('booking.lead') }}</p></div>
    <div class="booking__actions">
      <a class="btn btn--primary" href="{{ site.contacts.whatsapp_url }}?text={{ t('contact.text_page', title=svc.title) | urlencode }}" target="_blank" rel="noopener">{{ icon('message-circle') }} WhatsApp</a>
      <a class="btn btn--ghost" href="{{ site.contacts.telegram_url }}" target="_blank" rel="noopener">{{ icon('send') }} Telegram</a>
      <a class="btn btn--ghost" href="{{ site.contacts.instagram_url }}" target="_blank" rel="noopener">{{ icon('instagram') }} Instagram</a>
    </div>
    <p class="booking__loc">{{ icon('map-pin') }} {{ site.location }}</p>
  </div>
</section>

{% if svc.related %}
<section class="section container">
  <div class="section-head" data-reveal><p class="eyebrow">{{ t('service.related_eyebrow') }}</p><h2>{{ t('service.related_title') }}</h2></div>
  <div class="related-grid" data-reveal-children>
    {% for rslug in svc.related %}{% set r = services.get(rslug) %}{% if r %}
    <a class="related-card card" href="{{ href(rslug) }}">
      <div class="related-card__media">{{ responsive_img(card_image(r.hero_image), 'related_card', r.title) }}</div>
      <div class="related-card__body"><h3>{{ r.title }}</h3><span class="related-card__more">{{ t('cta.more') }} {{ icon('arrow-right') }}</span></div>
    </a>
    {% endif %}{% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}
{# Скрипт нужен только там, где вкладки есть: условие то же, что у самих вкладок
   (`tabbed` выше). При одном разделе прайса он находил ноль вкладок и уходил
   ни с чем — лишний запрос на 9 страницах услуг из 11. #}
{% block extra_js %}{% if sections|length > 1 %}<script src="{{ base_path }}/assets/js/price-tabs.js" defer></script>{% endif %}{% endblock %}
