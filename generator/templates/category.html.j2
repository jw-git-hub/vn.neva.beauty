{% extends "base.html.j2" %}
{% from "partials/picture.html.j2" import responsive_img %}
{% block content %}
<section class="section section--lead container">
  <nav class="breadcrumbs breadcrumbs--lead" aria-label="{{ t('nav.breadcrumbs_label') }}">
    <a href="{{ href('home') }}">{{ t('nav.home') }}</a>
    <span class="breadcrumbs__sep" aria-hidden="true">/</span>
    <span aria-current="page">{{ cat.title }}</span>
  </nav>
  <div class="section-head" data-reveal><p class="eyebrow">{{ t('category.eyebrow') }}</p><h1>{{ cat.title }}</h1><p>{{ cat.intro }}</p></div>
  <div class="related-grid" data-reveal-children>
    {% for slug in cat.services %}{% set r = services.get(slug) %}{% if r %}
    <a class="related-card card" href="{{ href(slug) }}">
      <div class="related-card__media">{{ responsive_img(card_image(r.hero_image), 'related_card', t('category.card_alt', title=r.title, category=cat.title)) }}</div>
      {# h2, а не h3: на странице-категории услуги и есть разделы страницы — под h1
         без промежуточного h2 уровень бы «прыгал». В «Смотрите также» на странице
         услуги та же карточка идёт h3, потому что там над ней есть свой h2. #}
      <div class="related-card__body"><h2>{{ r.title }}</h2><span class="related-card__more">{{ t('cta.more') }} {{ icon('arrow-right') }}</span></div>
    </a>
    {% endif %}{% endfor %}
  </div>
</section>

{% if cat.faq %}
<section class="section container" id="faq">
  <div class="section-head" data-reveal><p class="eyebrow">{{ t('faq.eyebrow') }}</p><h2>{{ t('faq.title', title=cat.title) }}</h2></div>
  <div class="faq" data-reveal-children>
    {% for item in cat.faq %}
    <details class="faq__item"{% if loop.first %} open{% endif %}>
      <summary class="faq__q">{{ item.q }}</summary>
      <p class="faq__a">{{ item.a | safe }}</p>
    </details>
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container booking">
    {#- Заголовок приходит от страницы. Один и тот же h2 на 14 страницах не
       говорил ни клиенту, ни роботу, о чём именно блок, и место в структуре
       страницы тратилось впустую. Дубли ловит check_headings.py.
       Подводка намеренно осталась общей: заказчик разрешил править только
       заголовки, остальной текст vn — отдельным решением. #}
    <div class="section-head" data-reveal><p class="eyebrow">{{ t('booking.eyebrow') }}</p><h2>{{ cat.booking_title }}</h2><p>{{ t('booking.lead') }}</p></div>
    <div class="booking__actions">
      <a class="btn btn--primary" {{ contact('whatsapp', 'booking', page) }}>{{ icon('message-circle') }} WhatsApp</a>
      <a class="btn btn--ghost" {{ contact('telegram', 'booking', page) }}>{{ icon('send') }} Telegram</a>
      <a class="btn btn--ghost" {{ contact('instagram', 'booking', page) }}>{{ icon('instagram') }} Instagram</a>
    </div>
    <p class="booking__loc">{{ icon('map-pin') }} {{ site.location }}</p>
  </div>
</section>

{# Переход в соседний раздел: со страницы услуги назад ведут и крошки,
   и «Смотрите также», а с раздела в соседний — только через меню в шапке. #}
{% set siblings = categories | rejectattr('slug', 'equalto', cat.slug) | list %}
{% if siblings %}
<section class="section container">
  <div class="section-head" data-reveal><p class="eyebrow">{{ t('category.others_eyebrow') }}</p><h2>{{ t('category.others_title', title=cat.title) }}</h2></div>
  <nav class="cat-links" aria-label="{{ t('category.others_eyebrow') }}">
    {% for other in siblings %}
    <a class="cat-links__item" href="{{ other.href }}">{{ other.title }} {{ icon('arrow-right') }}</a>
    {% endfor %}
  </nav>
</section>
{% endif %}
{% endblock %}
