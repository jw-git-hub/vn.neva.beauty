{% extends "base.html.j2" %}
{% from "partials/picture.html.j2" import responsive_img %}
{% block content %}
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">{{ home.hero_kicker | default(site.tagline) }}</p>
      <h1 class="hero__title">{% for line in home.hero_title_lines %}<span>{{ line }}</span>{{ " " }}{% endfor %}</h1>
      <p class="hero__sub">{{ home.hero_sub }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" {{ contact('whatsapp', 'hero', page) }}>{{ t('cta.book') }}</a>
        <a class="btn btn--ghost" href="#services">{{ t('cta.services') }}</a>
      </div>
    </div>
    <div class="hero__media">
      <span class="hero__blob" aria-hidden="true"></span>
      {{ responsive_img('hero', 'home_hero', t('home.hero_alt'), cls='hero__photo', priority=True) }}
    </div>
  </div>
</section>

<section class="container">
  <div class="contact-strip">
    <div class="contact-strip__item">{{ icon('map-pin') }}<span>{{ site.location }}</span></div>
    <div class="contact-strip__item">{{ icon('clock') }}<span>{{ site.hours }}</span></div>
    <div class="contact-strip__actions">
      <a class="btn btn--ghost btn--sm" {{ contact('telegram', 'strip', page) }}>{{ icon('send') }}<span>Telegram</span></a>
      <a class="btn btn--ghost btn--sm" {{ contact('whatsapp', 'strip', page) }}>{{ icon('message-circle') }}<span>WhatsApp</span></a>
    </div>
  </div>
</section>

<section class="section container" id="services">
  <div class="section-head" data-reveal><p class="eyebrow">{{ t('home.services_eyebrow') }}</p><h2>{{ t('home.services_title') }}</h2><p>{{ t('home.services_lead') }}</p></div>
  <div class="cat-grid" data-reveal-children>
    {% for c in categories %}
    <a class="cat-card card" href="{{ c.href }}">
      <div class="cat-card__media">{{ responsive_img(c.image, 'category_cover', c.title) }}</div>
      <div class="cat-card__body"><h3>{{ c.title }}</h3><span class="cat-card__more">{{ t('cta.more') }} {{ icon('arrow-right') }}</span></div>
    </a>
    {% endfor %}
  </div>
</section>

<section class="section benefits-section">
  <div class="container">
    <div class="section-head" data-reveal><p class="eyebrow">{{ t('home.benefits_eyebrow') }}</p><h2>{{ t('home.benefits_title') }}</h2></div>
    <div class="benefits-grid" data-reveal-children>
      {% for b in home.benefits %}
      <div class="benefit"><span class="benefit__icon">{{ icon(b.icon) }}</span><h3>{{ b.title }}</h3><p>{{ b.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section container">
  <div class="section-head" data-reveal><p class="eyebrow">{{ t('home.popular_eyebrow') }}</p><h2>{{ t('home.popular_title') }}</h2><p>{{ t('home.popular_lead') }}</p></div>
  <div class="popular-grid" data-reveal-children>
    {% for p in home.popular %}
    <a class="popular-card card" href="{{ href(p.slug) }}">
      <span class="popular-card__info">
        <span class="popular-card__cat">{{ p.label }}</span>
        <span class="popular-card__name">{{ p.name }}</span>
      </span>
      <span class="popular-card__price">{{ p.price }}</span>
    </a>
    {% endfor %}
  </div>
</section>

<section class="section container" id="faq">
  <div class="section-head" data-reveal>
    <p class="eyebrow">{{ t('faq.eyebrow') }}</p>
    <h2>{{ t('home.faq_title') }}</h2>
    <p>{{ home.about_lead }}</p>
  </div>
  <div class="faq" data-reveal-children>
    {% for item in home.faq %}
    <details class="faq__item"{% if loop.first %} open{% endif %}>
      <summary class="faq__q">{{ item.q }}</summary>
      <p class="faq__a">{{ item.a | safe }}</p>
    </details>
    {% endfor %}
  </div>
</section>

<section class="section">
  <div class="container booking">
    {#- Заголовок приходит от страницы. Один и тот же h2 на 14 страницах не
       говорил ни клиенту, ни роботу, о чём именно блок, и место в структуре
       страницы тратилось впустую. Дубли ловит check_headings.py.
       Подводка намеренно осталась общей: заказчик разрешил править только
       заголовки, остальной текст vn — отдельным решением. #}
    <div class="section-head" data-reveal><p class="eyebrow">{{ t('booking.eyebrow') }}</p><h2>{{ home.booking_title }}</h2><p>{{ t('booking.lead') }}</p></div>
    <div class="booking__actions">
      <a class="btn btn--primary" {{ contact('whatsapp', 'booking', page) }}>{{ icon('message-circle') }} WhatsApp</a>
      <a class="btn btn--ghost" {{ contact('telegram', 'booking', page) }}>{{ icon('send') }} Telegram</a>
      <a class="btn btn--ghost" {{ contact('instagram', 'booking', page) }}>{{ icon('instagram') }} Instagram</a>
    </div>
    <p class="booking__loc">{{ icon('map-pin') }} {{ site.location }}</p>
  </div>
</section>
{% endblock %}
