{% if site.metrika_id %}
<!-- Yandex.Metrika counter -->
{#- tag.js весит 110 КБ в gzip и 289 КБ распакованного JS — больше, чем весь
    остальной фронтенд сайта вместе со шрифтами (CSS 7 КБ + JS 3 КБ + шрифты
    71 КБ). Разбор такого объёма занимает главный поток ровно тогда, когда
    браузер должен рисовать первый экран, поэтому счётчик грузится не сразу,
    а по первому действию посетителя или через 1,2 с после load — что наступит
    раньше.

    Вызовы при этом не теряются: заглушка ym() ставится сразу и копит аргументы
    в очередь ym.a, а приехавший tag.js разбирает её — это штатный механизм
    самого счётчика, init отработает задним числом.

    Цена решения: визит, оборвавшийся раньше загрузки tag.js, в статистику не
    попадёт. Если счётчик важнее скорости — убрать обёртку и вернуть прямую
    вставку из справки Метрики. -#}
<script>
(function (w, d) {
  w.ym = w.ym || function () { (w.ym.a = w.ym.a || []).push(arguments) };
  w.ym.l = 1 * new Date();
  {#- webvisor выключен осознанно. Вебвизор — запись сессий: он постоянно
      сериализует DOM, пишет движения мыши и прокрутку и шлёт это на сервер всё
      время, пока страница открыта. Это самая тяжёлая часть Метрики уже ПОСЛЕ
      загрузки, и заказчик записями не пользуется. Карта кликов, отслеживание
      ссылок и точный показатель отказов остаются — они почти ничего не стоят. #}
  {#- Переход по языку (language_redirect.html.j2): document.referrer после него — наша
      же страница, и визит из поиска записался бы внутренним. Скрипт выбора языка
      сохранил настоящий источник; до загрузки tag.js он подставляется в сам
      document.referrer, и счётчик видит его во всех запросах. Пустая строка — прямой
      заход: передать её через hit нельзя, для счётчика она значит «не задано». #}
  try {
    var source = sessionStorage.getItem({{ language_source_key | tojson }});
    if (source !== null) {
      sessionStorage.removeItem({{ language_source_key | tojson }});
      Object.defineProperty(d, "referrer", {get: function () { return source; }});
    }
  } catch (e) {}
  var COUNTER = {{ site.metrika_id }};
  ym(COUNTER, "init", {
       clickmap:true,
       trackLinks:true,
       accurateTrackBounce:true,
       webvisor:false
  });
  {#- Клики по ссылкам: один обработчик на весь документ, click и auxclick (средняя
      кнопка — «открыть в новой вкладке»). Ссылка связи (data-contact, см. contacts.py)
      уходит целью contact: плоские параметры визита (канал, язык, страница, место
      кнопки) и ветка «contacts by page» → страница → канал → место, чтобы пара
      «страница → мессенджер» была в одной таблице. Переход на другой сайт и mailto:/tel:
      уходят параметрами визита «exits by page» → страница → сайт, без цели: заводить её
      в кабинете не нужно. Ссылка связи второй раз в exits не попадает.

      Известное ограничение: если клик по ссылке — первое действие гостя, tag.js ещё не
      загружен и вызов ждёт в очереди ym.a. Ссылка связи открывается в новой вкладке или
      в приложении; если гость не вернётся на страницу, вызов может не уйти. Внешняя ссылка
      в той же вкладке (th.neva.beauty) до загрузки tag.js теряет вызов при уходе со
      страницы. Автоцель «переход в мессенджер» (trackLinks) работает по-прежнему. #}
  var PAGE = {{ page.id | tojson }};
  var PAGE_URL = {{ page.url | tojson }};
  var CONTACTS_BY_PAGE = "contacts by page";
  var EXITS_BY_PAGE = "exits by page";
  var SCHEME_NAMES = {"mailto:": "e-mail", "tel:": "phone"};
  var WEB_SCHEMES = ["http:", "https:"];
  var MIDDLE_BUTTON = 1;

  function nest(keys, leaf) {
    return keys.reduceRight(function (inner, key) {
      var level = {};
      level[key] = inner;
      return level;
    }, leaf);
  }

  function reportContact(link) {
    var channel = link.getAttribute("data-contact");
    var place = link.getAttribute("data-place");
    var params = {channel: channel, lang: d.documentElement.lang, page: PAGE, place: place};
    params[CONTACTS_BY_PAGE] = nest([PAGE_URL, channel], place);
    ym(COUNTER, "reachGoal", "contact", params);
  }

  function destinationOf(link) {
    if (WEB_SCHEMES.indexOf(link.protocol) === -1) return SCHEME_NAMES[link.protocol] || null;
    return link.hostname === location.hostname ? null : link.hostname;
  }

  function reportExit(link) {
    var destination = destinationOf(link);
    if (destination === null) return;
    var params = {};
    params[EXITS_BY_PAGE] = nest([PAGE_URL], destination);
    ym(COUNTER, "params", params);
  }

  function reportLinkClick(event) {
    if (event.type === "auxclick" && event.button !== MIDDLE_BUTTON) return;
    var link = event.target.closest && event.target.closest("a[href]");
    if (!link) return;
    if (link.hasAttribute("data-contact")) reportContact(link);
    else reportExit(link);
  }
  d.addEventListener("click", reportLinkClick);
  d.addEventListener("auxclick", reportLinkClick);

  var SRC = "https://mc.yandex.ru/metrika/tag.js";
  var started = false;

  function start() {
    if (started) return;
    started = true;
    for (var i = 0; i < d.scripts.length; i++) if (d.scripts[i].src === SRC) return;
    var s = d.createElement("script");
    s.async = 1;
    s.src = SRC;
    d.head.appendChild(s);
  }

  ["pointerdown", "keydown", "touchstart", "scroll"].forEach(function (name) {
    addEventListener(name, start, { once: true, passive: true });
  });

  function afterLoad() { setTimeout(start, 1200); }
  if (d.readyState === "complete") afterLoad();
  else addEventListener("load", afterLoad, { once: true });
})(window, document);
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/{{ site.metrika_id }}" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
<!-- /Yandex.Metrika counter -->
{% endif %}
