{% if site.metrika_id %}
<!-- Yandex.Metrika counter -->
{#- tag.js весит 110 КБ в gzip и 289 КБ распакованного JS — больше, чем весь
    остальной фронтенд сайта вместе со шрифтами (CSS 7 КБ + JS 3 КБ + шрифты
    71 КБ). Разбор такого объёма занимает главный поток ровно тогда, когда
    браузер должен рисовать первый экран, поэтому счётчик грузится не сразу,
    а по первому действию посетителя или через 1,2 с после load — что наступит
    раньше.

    Вызовы при этом не теряются: заглушка ym() ставится сразу и копит аргументы
    в очередь ym.a, а приехавший tag.js разбирает её — это штатный механизм
    самого счётчика, init отработает задним числом.

    Цена решения: визит, оборвавшийся раньше загрузки tag.js, в статистику не
    попадёт. Если счётчик важнее скорости — убрать обёртку и вернуть прямую
    вставку из справки Метрики. -#}
<script>
(function (w, d) {
  w.ym = w.ym || function () { (w.ym.a = w.ym.a || []).push(arguments) };
  w.ym.l = 1 * new Date();
  {#- webvisor выключен осознанно. Вебвизор — запись сессий: он постоянно
      сериализует DOM, пишет движения мыши и прокрутку и шлёт это на сервер всё
      время, пока страница открыта. Это самая тяжёлая часть Метрики уже ПОСЛЕ
      загрузки, и заказчик записями не пользуется. Карта кликов, отслеживание
      ссылок и точный показатель отказов остаются — они почти ничего не стоят. #}
  ym({{ site.metrika_id }}, "init", {
       clickmap:true,
       trackLinks:true,
       accurateTrackBounce:true,
       webvisor:false
  });

  var SRC = "https://mc.yandex.ru/metrika/tag.js";
  var started = false;

  function start() {
    if (started) return;
    started = true;
    for (var i = 0; i < d.scripts.length; i++) if (d.scripts[i].src === SRC) return;
    var s = d.createElement("script");
    s.async = 1;
    s.src = SRC;
    d.head.appendChild(s);
  }

  ["pointerdown", "keydown", "touchstart", "scroll"].forEach(function (name) {
    addEventListener(name, start, { once: true, passive: true });
  });

  function afterLoad() { setTimeout(start, 1200); }
  if (d.readyState === "complete") afterLoad();
  else addEventListener("load", afterLoad, { once: true });
})(window, document);
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/{{ site.metrika_id }}" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
<!-- /Yandex.Metrika counter -->
{% endif %}
