{% from 'partials/locations.html.j2' import loc_switch %}
<header class="site-header" data-header>
  <div class="container site-header__inner">
    {# Замок здесь собран не макросом brand_mark, а loc_switch: строка города —
       кнопка переключателя салонов, а кнопка не может стоять внутри ссылки.
       В подвале и дровере город ничего не открывает, там остаётся brand_mark. #}
    {{ loc_switch(site, 'lotus') }}
    <nav class="nav" aria-label="{{ t('nav.main_label') }}">
      {% for item in site.nav %}
        {% if item.children %}
        <div class="nav__group">
          <button class="nav__link nav__toggle" aria-expanded="false">{{ item.label }}<svg class="nav__chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
          <div class="nav__menu">
            <a class="nav__lead" href="{{ item.href }}"><span>{{ item.title }}</span><svg class="lead-arrow" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9"/><path d="m8.5 4 4 4-4 4"/></svg></a>
            {% for c in item.children %}<a class="nav__sub" href="{{ c.href }}">{{ c.label }}</a>{% endfor %}
          </div>
        </div>
        {% else %}
        <a class="nav__link" href="{{ item.href }}">{{ item.label }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <a class="btn btn--primary site-header__cta" href="{{ site.contacts.whatsapp_url }}?text={{ t('contact.text_generic') | urlencode }}" target="_blank" rel="noopener">{{ t('cta.book') }}</a>
    <button class="burger" data-drawer-open aria-label="{{ t('nav.open_menu') }}" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</header>
