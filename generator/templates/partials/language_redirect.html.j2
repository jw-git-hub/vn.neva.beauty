{#- Выбор языка по браузеру (спека, раздел 14; данные — language_redirect.py). Стоит
    первым в head, до стилей: переход случается до отрисовки, гость не видит мигания.
    Робот и переход внутри сайта — без перехода. Иначе: сохранённый ручной выбор, иначе
    первая группа языков браузера, иначе язык для остальных. location.replace не
    оставляет записи в истории — «Назад» не зацикливается; строка запроса и якорь
    сохраняются, источник визита кладётся в sessionStorage для Метрики.
    Комментариев внутри скрипта нет: он стоит и на английских страницах. -#}
<script>
(function (C) {
  function stored(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
  function isInternal(referrer) {
    try { return !!referrer && new URL(referrer).host === location.host; } catch (e) { return false; }
  }
  function prefersGroup(languages, group) {
    return languages.some(function (tag) {
      return group.indexOf(String(tag).toLowerCase().split("-")[0]) !== -1;
    });
  }
  function choose(languages) {
    var saved = stored(C.storageKey);
    if (saved && C.pairs[saved]) return saved;
    for (var i = 0; i < C.groups.length; i++) {
      if (prefersGroup(languages, C.groups[i][1])) return C.groups[i][0];
    }
    return C.fallback;
  }
  if (new RegExp(C.bots, "i").test(navigator.userAgent) || isInternal(document.referrer)) return;
  var target = choose(navigator.languages || [navigator.language || ""]);
  if (target === C.current || !C.pairs[target]) return;
  try { sessionStorage.setItem(C.sourceKey, document.referrer); } catch (e) {}
  location.replace(C.pairs[target] + location.search + location.hash);
})({{ redirect | tojson }});
</script>
