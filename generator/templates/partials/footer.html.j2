{% from 'partials/brand.html.j2' import brand_mark %}
{% from 'partials/locations.html.j2' import loc_list %}
{%- from 'partials/language_switch.html.j2' import lang_line %}
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__col site-footer__brand">
      <span class="site-footer__logo brand-mark">{{ brand_mark(site.brand, site.brand_location) }}</span>
      {{ loc_list(site) }}
    </div>
    <nav class="site-footer__col" aria-label="{{ t('footer.services_title') }}">
      <h2 class="site-footer__title">{{ t('footer.services_title') }}</h2>
      {% for item in site.nav %}
        {% if item.children %}{% for c in item.children %}<a class="site-footer__link" href="{{ c.href }}">{{ c.label }}</a>{% endfor %}
        {% elif not item.is_home %}<a class="site-footer__link" href="{{ item.href }}">{{ item.label }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="site-footer__col">
      <h2 class="site-footer__title">{{ t('footer.contacts_title') }}</h2>
      <a class="site-footer__link" {{ contact('whatsapp', 'footer', page) }}>WhatsApp</a>
      <a class="site-footer__link" {{ contact('telegram', 'footer', page) }}>Telegram</a>
      <a class="site-footer__link" {{ contact('instagram', 'footer', page) }}>Instagram</a>
    </div>
  </div>
  <div class="site-footer__bottom container">
    <span>{{ t('footer.copyright') }}</span>
    <a href="{{ href('privacy') }}">{{ t('footer.privacy') }}</a>
    {{ lang_line(page, 'site-footer__langs') }}
  </div>
</footer>
